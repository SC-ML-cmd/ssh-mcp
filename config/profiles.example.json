{
  "profiles": {
    "dev": {
      "host": "10.0.0.10",
      "port": 22,
      "username": "your-user",
      "key_filename": "C:/Users/you/.ssh/id_rsa",
      "passphrase_env": "SSH_MCP_KEY_PASSPHRASE",
      "timeout": 15,
      "banner_timeout": 15,
      "auth_timeout": 15,
      "allow_agent": true,
      "look_for_keys": true,
      "auto_add_host_key": true,
      "term": "xterm-256color",
      "width": 120,
      "height": 40,
      "enter_sequence": "lf",
      "keepalive_interval": 30,
      "security": {
        "mode": "unrestricted",
        "redact_transcripts": true,
        "transcript_retention_days": 14,
        "transcript_max_files": 200
      }
    },
    "password-dev": {
      "host": "10.0.0.11",
      "username": "your-user",
      "password_env": "SSH_MCP_PASSWORD",
      "allow_agent": false,
      "look_for_keys": false,
      "keepalive_interval": 30,
      "security": {
        "mode": "readonly"
      }
    }
  }
}
